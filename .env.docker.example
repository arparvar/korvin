# Korvin Docker Configuration
# ?????????????????????????????????????????????????????
# 1. Copy this file to .env
# 2. Fill in your values below
# 3. Copy litellm_config.docker.yaml to litellm_config.yaml
# 4. Run: docker compose up -d
# 5. Open: http://localhost:3002
# Never commit .env to git.

# ?? REQUIRED ?????????????????????????????????????????

# Your AI model key. Korvin works with Gemini (free) or DeepSeek.
# Get Gemini free (no credit card): https://aistudio.google.com/
# Gemini keys start with "AIza". Leave the other one blank.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Your dashboard login password ? choose anything strong (12+ chars)
KORVIN_API_KEY=

# Internal routing key ? run this to generate one:
#   openssl rand -hex 32
# Or just type any long random string. This stays inside Docker.
LITELLM_MASTER_KEY=

# ?? OPTIONAL ?????????????????????????????????????????

# Telegram bot token ? get from @BotFather on Telegram
# Leave blank to use dashboard only (no Telegram bot)
# To start the Telegram bot: docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID ? get from @userinfobot on Telegram
KORVIN_CHAT_ID=

# Active model ? gemini-flash or deepseek-v4-pro or deepseek-v4-flash
KORVIN_MODEL=gemini-flash
